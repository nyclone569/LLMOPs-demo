# ── AWS ──────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=123456789012

# ── Supabase ─────────────────────────────────────
LANGFUSE_DB_URL=postgresql://langfuse_user:pass@db.xxx.supabase.co:5432/postgres?schema=langfuse
LITELLM_DB_URL=postgresql://litellm_user:pass@db.xxx.supabase.co:5432/postgres?schema=litellm

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Providers ────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── LiteLLM ──────────────────────────────────────
LITELLM_MASTER_KEY=sk-litellm-...        # key để gọi vào gateway
LITELLM_SALT_KEY=random-salt-string

# ── Langfuse ─────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://langfuse:3000       # local: service name, prod: domain

# ── Open WebUI ───────────────────────────────────
WEBUI_SECRET_KEY=random-secret
OPENAI_API_BASE=http://litellm:4000      # trỏ vào LiteLLM gateway
OPENAI_API_KEY=${LITELLM_MASTER_KEY}     # dùng lại master key