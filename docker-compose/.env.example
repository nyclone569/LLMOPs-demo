# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================

# Point these at either:
# - the local `postgres` service in docker-compose, or
# - any external PostgreSQL instance you manage separately.

# For Langfuse (runtime)
LANGFUSE_DATABASE_URL=postgresql://llmops:llmops_password_change_me@postgres:5432/langfuse

# For Langfuse migrations / direct connection
LANGFUSE_DIRECT_URL=postgresql://llmops:llmops_password_change_me@postgres:5432/langfuse

# For LiteLLM
LITELLM_DATABASE_URL=postgresql://llmops:llmops_password_change_me@postgres:5432/litellm

# For Open WebUI
OPENWEBUI_DATABASE_URL=postgresql://llmops:llmops_password_change_me@postgres:5432/openwebui

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================

# LLM Provider API Keys
# Get these from respective provider dashboards

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: AWS Bedrock (if using)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# =============================================================================
# LANGFUSE CONFIGURATION
# =============================================================================

# Langfuse Keys (generate these after first login to Langfuse UI)
# Login to http://localhost:3000 and create a project to get these
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://langfuse-server:3000

# Langfuse Secrets (generate random 32+ character strings)
# You can use: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_langfuse_secret_min_32_chars_required_here
SALT=changeme_salt_min_32_chars
ENCRYPTION_KEY=changeme_encryption_key_must_be_32_chars_exactly_here

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================

# LiteLLM Master Key (used by Open WebUI to authenticate)
LITELLM_MASTER_KEY=sk-1234567890abcdef
